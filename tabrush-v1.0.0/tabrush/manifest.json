{
  "manifest_version": 3,
  "name": "TabRush",
  "description": "Reload every open tab with one keyboard shortcut.",
  "version": "1.0.0",
  "minimum_chrome_version": "88",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "tabrush-reload-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Reload all open tabs"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
